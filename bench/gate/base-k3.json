  "tasks": {
    "truth": "/var/tmp/glarb-bench/demo/data/truth.jsonl",
    "creds": "/var/tmp/glarb-bench/demo/data/creds.tsv"
  },
  "desk": {
    "launch": [
      "sudo",
      "systemd-run",
      "--quiet",
      "--collect",
      "--unit=pdesk-gate-{i}",
      "--slice=panoptes.slice",
      "-p",
      "User=user",
      "-p",
      "Group=user",
      "-p",
      "Delegate=yes",
      "-p",
      "StandardOutput=file:{run}/desk.log",
      "-p",
      "StandardError=file:{run}/desk.log",
      "-p",
      "Environment=PANOPTES_PDFTOTEXT=/nix/store/q0ld5mmjh89nar306jb0izrcf8phy5v9-poppler-utils-26.10.0/bin/pdftotext",
      "sh",
      "-c",
      ". /var/tmp/glarb-bench/scripts/env.sh; exec /var/tmp/glarb-bench/panoptes-gate/target/release/panoptes-desk --run-dir {run} --size 1280x800"
    ],
    "stop": [
      "sh",
      "-c",
      "sudo systemctl stop pdesk-gate-{i} 2>/dev/null; sudo systemctl reset-failed pdesk-gate-{i} 2>/dev/null; true"
    ]
  },
  "out_dir": "/var/tmp/glarb-bench/panoptes-run/gate",
  "run_name": "SET",
  "step_cap": 60,
  "acting_cap": 1,
  "phase_caps": {},
  "budget": {
    "ledger": "/var/tmp/glarb-bench/panoptes-run/gate/spent.usd",
    "cap_usd": 4.50
  },
  "invoice_cost_cap_usd": 0.5,
  "history_full": 1
}
